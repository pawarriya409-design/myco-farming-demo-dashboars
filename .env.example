# Copy to .env and fill in. Restart `npm run dev` after changing.
# Folder URL that contains sites.csv and monitoring_<SITE_ID>.csv (no trailing slash).
# The host must allow CORS GET requests from the dashboard's origin.
VITE_DATA_BASE_URL=https://my-bucket.s3.eu-west-1.amazonaws.com/myco
# Background refresh interval in seconds (0 = off)
VITE_POLL_SECONDS=60
